# Beispiel-Datei für Streamlit Secrets (nur für die optionale app.py / HubSpot-API-Anbindung).
#
# So verwendest du sie:
# 1. Kopiere diese Datei nach .streamlit/secrets.toml
# 2. Trage dort deinen echten HubSpot Private App Token ein
# 3. .streamlit/secrets.toml wird NICHT committet (siehe .gitignore)
#
# Für Streamlit Cloud: Trage den Wert stattdessen unter
# "App settings -> Secrets" im gleichen TOML-Format ein.

HUBSPOT_PRIVATE_APP_TOKEN = "pat-eu1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
