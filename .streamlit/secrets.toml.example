# Beispiel-Datei für Streamlit Secrets (nur für die optionale app.py / HubSpot-API-Anbindung).
#
# So verwendest du sie:
# 1. Kopiere diese Datei nach .streamlit/secrets.toml
# 2. Trage dort deinen echten HubSpot Private App Token ein
# 3. .streamlit/secrets.toml wird NICHT committet (siehe .gitignore)
#
# Für Streamlit Cloud: Trage den Wert stattdessen unter
# "App settings -> Secrets" im gleichen TOML-Format ein.

HUBSPOT_PRIVATE_APP_TOKEN = "pat-eu1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

# Optional: nur für die sparsame Websuche zur Zimmeranzahl (Stufe 2, siehe
# logic/web_search.py). Ohne diese Werte startet und funktioniert die App
# ganz normal - es entfällt dann lediglich die zusätzliche Websuche, falls
# weder Excel noch die offizielle Website eine Zimmeranzahl liefern.
# SEARCH_API_KEY = "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# SEARCH_API_ENDPOINT = "https://api.bing.microsoft.com/v7.0/search"

# Optional: nur für echte Fahrzeiten/Distanzen im Reiter "Routenplanung"
# (siehe logic/routing_provider.py). Ohne diesen Key startet und funktioniert
# die App ganz normal - Termine werden dann chronologisch angezeigt, aber
# ohne Fahrzeit-/Distanzangaben (kein Fehler, keine erfundenen Werte).
# Kostenloser Key z.B. über https://openrouteservice.org.
# ROUTING_API_KEY = "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# ROUTING_API_ENDPOINT = "https://api.openrouteservice.org/v2/matrix/driving-car"

# Optional: alternativer Geocoding-Endpunkt für den Reiter "Routenplanung"
# (siehe logic/geocoding.py). Standardmäßig wird der kostenlose
# OpenStreetMap-Nominatim-Dienst verwendet - kein Key nötig.
# GEOCODING_API_ENDPOINT = "https://nominatim.openstreetmap.org/search"
